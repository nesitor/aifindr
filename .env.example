PORT=3000
DATABASE_PATH=./data/gateway.db

SESSION_COOKIE_SECRET=
PROPOSAL_TTL_SECONDS=300
PUBLIC_BASE_URL=http://localhost:3000

# Cuántos proxies hay delante del gateway. Si no se define: 1 cuando PUBLIC_BASE_URL apunta a un
# dominio público (ngrok), 0 en local. Debe ser un entero, nunca `true`: con `trust proxy` a true
# cualquiera puede falsificar X-Forwarded-For y saltarse el limitador de peticiones de OAuth.
TRUST_PROXY=

# Atajo de demostración: habilita POST /api/cards/:id/reset para repetir la prueba.
# Debe quedar en false o sin definir fuera de una demo.
DEMO_MODE=false
